generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPANY
}

enum RentalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BusinessType {
  SALE
  RENTAL
  EXCHANGE
  SERVICE
}

enum MachineCategory {
  TRACTORS
  HARVESTERS
  PLANTING
  SPRAYING
  HAYMAKING
  IMPLEMENTS
  LIVESTOCK
  CONSTRUCTION
}

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  createdAt DateTime @default(now())

  users      User[]
  equipments Equipment[]
  rentals    Rental[]     @relation("RenterCompany")

  @@map("companies")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  role          UserRole @default(COMPANY)
  companyId     String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  company                  Company?                   @relation(fields: [companyId], references: [id])
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  machines                 Machine[]

  @@map("users")
}

model Equipment {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String
  pricePerDay Decimal  @db.Decimal(10, 2)
  location    String
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  rentals Rental[]

  @@map("equipments")
}

model Rental {
  id               String       @id @default(uuid())
  equipmentId      String
  renterCompanyId  String
  startDate        DateTime
  endDate          DateTime
  status           RentalStatus @default(PENDING)
  createdAt        DateTime     @default(now())

  equipment      Equipment @relation(fields: [equipmentId], references: [id])
  renterCompany  Company   @relation("RenterCompany", fields: [renterCompanyId], references: [id])
  payment        Payment?

  @@map("rentals")
}

model Payment {
  id        String        @id @default(uuid())
  rentalId  String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@map("payments")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Machine {
  id              String          @id @default(uuid())
  businessType    BusinessType
  name            String
  description     String          @db.Text
  category        MachineCategory
  manufacturer    String
  model           String
  yearModel       Int
  power           Int?
  engineHours     Int?
  serialNumber    String?
  price           Decimal         @db.Decimal(12, 2)
  acceptsTradeDown Boolean        @default(false)
  acceptsTradeUp   Boolean        @default(false)
  acceptsGrains    Boolean        @default(false)
  acceptsFinancing Boolean        @default(false)
  state           String
  city            String
  zipCode         String?
  images          String[]
  videoUrl        String?
  quickTags       String[]
  ownerId         String
  ownerName       String
  ownerPhone      String?
  isVerifiedSeller Boolean       @default(false)
  available       Boolean         @default(true)
  views           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  owner           User            @relation(fields: [ownerId], references: [id])
  
  @@index([category])
  @@index([businessType])
  @@index([state])
  @@index([city])
  @@index([manufacturer])
  @@index([yearModel])
  @@index([engineHours])
  @@index([power])
  @@index([ownerId])
  @@index([price])
  @@map("machines")
}
