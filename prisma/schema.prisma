generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPANY
}

enum RentalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BusinessType {
  SALE
  RENTAL
  EXCHANGE
  SERVICE
}

enum MachineCategory {
  TRACTORS
  HARVESTERS
  PLANTING
  SPRAYING
  HAYMAKING
  IMPLEMENTS
  LIVESTOCK
  CONSTRUCTION
}

enum NotificationType {
  NEW_REVIEW
  PRICE_DROP
  NEW_MESSAGE
  NEW_MACHINE
  MACHINE_SOLD
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  createdAt DateTime @default(now())

  users      User[]
  equipments Equipment[]
  rentals    Rental[]     @relation("RenterCompany")

  @@map("companies")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  phone            String?
  role             UserRole @default(COMPANY)
  companyId        String?
  emailVerified    Boolean  @default(false)
  isBanned         Boolean  @default(false)
  isVerifiedSeller Boolean  @default(false)
  plan             String   @default("free")
  maxAds           Int      @default(3)
  createdAt        DateTime @default(now())

  company                  Company?                   @relation(fields: [companyId], references: [id])
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  machines                 Machine[]
  favorites                Favorite[]
  reviewsGiven             Review[]                   @relation("ReviewerUser")
  reviewsReceived          Review[]                   @relation("ReviewedUser")
  notifications            Notification[]
  proposalsSent            Proposal[]                 @relation("ProposalSender")
  proposalsReceived        Proposal[]                 @relation("ProposalReceiver")

  @@index([plan])
  @@map("users")
}

model Equipment {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  description     String
  pricePerDay     Decimal  @db.Decimal(10, 2)
  location        String
  images          String[]
  isActive        Boolean  @default(true)
  isPremium       Boolean  @default(false)
  views           Int      @default(0)
  whatsappClicks  Int      @default(0)
  qualifiedLeads  Int      @default(0)
  createdAt       DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  rentals Rental[]

  @@index([isPremium])
  @@map("equipments")
}

model Rental {
  id               String       @id @default(uuid())
  equipmentId      String
  renterCompanyId  String
  startDate        DateTime
  endDate          DateTime
  status           RentalStatus @default(PENDING)
  createdAt        DateTime     @default(now())

  equipment      Equipment @relation(fields: [equipmentId], references: [id])
  renterCompany  Company   @relation("RenterCompany", fields: [renterCompanyId], references: [id])
  payment        Payment?

  @@map("rentals")
}

model Payment {
  id        String        @id @default(uuid())
  rentalId  String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@map("payments")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  machineId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
  @@map("favorites")
}

model Review {
  id             String   @id @default(uuid())
  reviewerId     String
  reviewedUserId String
  machineId      String?
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviewer     User     @relation("ReviewerUser", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User     @relation("ReviewedUser", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  machine      Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@unique([reviewerId, reviewedUserId, machineId])
  @@index([reviewedUserId])
  @@index([reviewerId])
  @@index([machineId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Machine {
  id              String          @id @default(uuid())
  businessType    BusinessType
  name            String
  description     String          @db.Text
  category        MachineCategory
  manufacturer    String
  model           String
  yearModel       Int
  power           Int?
  engineHours     Int?
  serialNumber    String?
  price           Decimal         @db.Decimal(12, 2)
  acceptsTradeDown Boolean        @default(false)
  acceptsTradeUp   Boolean        @default(false)
  acceptsGrains    Boolean        @default(false)
  acceptsFinancing Boolean        @default(false)
  state           String
  city            String
  zipCode         String?
  images          String[]
  videoUrl        String?
  quickTags       String[]
  ownerId         String
  ownerName       String
  ownerPhone      String?
  isVerifiedSeller Boolean       @default(false)
  available       Boolean         @default(true)
  status          String          @default("ACTIVE")
  isFeatured      Boolean         @default(false)
  isPremium       Boolean         @default(false)
  views           Int             @default(0)
  whatsappClicks  Int             @default(0)
  qualifiedLeads  Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  owner           User            @relation(fields: [ownerId], references: [id])
  favorites       Favorite[]
  reviews         Review[]
  proposals       Proposal[]
  
  @@index([category])
  @@index([businessType])
  @@index([state])
  @@index([city])
  @@index([manufacturer])
  @@index([yearModel])
  @@index([engineHours])
  @@index([power])
  @@index([ownerId])
  @@index([price])
  @@map("machines")
}

model Proposal {
  id                String         @id @default(uuid())
  machineId         String
  senderId          String
  receiverId        String
  proposedPrice     Decimal        @db.Decimal(12, 2)
  message           String         @db.Text
  status            ProposalStatus @default(PENDING)
  counterPrice      Decimal?       @db.Decimal(12, 2)
  counterMessage    String?        @db.Text
  viewedByReceiver  Boolean        @default(false)
  viewedBySender    Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  machine  Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sender   User    @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ProposalReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("proposals")
}

model SiteSetting {
  id              String   @id @default(uuid())
  siteName        String   @default("Mercado Máquina")
  homeTitle       String?
  homeDescription String?  @db.Text
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model Banner {
  id         String   @id @default(uuid())
  imageUrl   String
  link       String?
  active     Boolean  @default(true)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("banners")
}
