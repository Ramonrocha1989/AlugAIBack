generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPANY
}

enum UserType {
  INDIVIDUAL
  COMPANY
}

enum BusinessType {
  SALE
  RENTAL
  EXCHANGE
  SERVICE
}

enum NotificationType {
  NEW_REVIEW
  PRICE_DROP
  NEW_MESSAGE
  NEW_MACHINE
  MACHINE_SOLD
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

model Company {
  id           String   @id @default(uuid())
  name         String
  document     String
  documentHash String   @unique
  createdAt    DateTime @default(now())

  users User[]

  @@map("companies")
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  phone            String?
  role             UserRole  @default(COMPANY)
  userType         UserType  @default(COMPANY)
  fullName         String?
  cpf              String?
  responsibleName  String?
  companyId        String?
  emailVerified    Boolean   @default(false)
  isBanned         Boolean   @default(false)
  isVerifiedSeller Boolean   @default(false)
  plan             String    @default("free")
  planExpiresAt    DateTime?
  maxAds           Int       @default(2)
  maxPhotos        Int       @default(3)
  maxVideos        Int       @default(0)
  maxPremiumAds    Int       @default(0)
  maxFeaturedAds   Int       @default(0)
  subscriptionId   String?
  deletedAt        DateTime?
  status           String    @default("ACTIVE")
  companyName      String?
  description      String?   @db.Text
  website          String?
  location         String?
  logo             String?
  banner           String?
  businessHours    String?
  categoriesWorked String[]
  gallery          String[]
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  company                 Company?                 @relation(fields: [companyId], references: [id])
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens           RefreshToken[]
  deleteTokens            DeleteToken[]
  machines                Machine[]
  favorites               Favorite[]
  reviewsGiven            Review[]                 @relation("ReviewerUser")
  reviewsReceived         Review[]                 @relation("ReviewedUser")
  notifications           Notification[]
  proposalsSent           Proposal[]               @relation("ProposalSender")
  proposalsReceived       Proposal[]               @relation("ProposalReceiver")
  payments                Payment[]
  verificationRequests    VerificationRequest[]

  @@index([plan])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model DeleteToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("delete_tokens")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  machineId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
  @@map("favorites")
}

model Review {
  id             String   @id @default(uuid())
  reviewerId     String
  reviewedUserId String
  machineId      String?
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviewer     User     @relation("ReviewerUser", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User     @relation("ReviewedUser", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  machine      Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@unique([reviewerId, reviewedUserId, machineId])
  @@index([reviewedUserId])
  @@index([reviewerId])
  @@index([machineId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Machine {
  id               String          @id @default(uuid())
  businessType     BusinessType
  name             String
  description      String          @db.Text
  category         String
  manufacturer     String
  model            String
  yearModel        Int
  power            Int?
  engineHours      Int?
  serialNumber     String?
  price            Decimal         @db.Decimal(12, 2)
  acceptsTradeDown Boolean         @default(false)
  acceptsTradeUp   Boolean         @default(false)
  acceptsGrains    Boolean         @default(false)
  acceptsFinancing Boolean         @default(false)
  state            String
  city             String
  zipCode          String?
  images           String[]
  videoUrl         String?
  quickTags        String[]
  ownerId          String
  ownerName        String
  ownerPhone       String?
  isVerifiedSeller Boolean         @default(false)
  available        Boolean         @default(true)
  status           String          @default("ACTIVE")
  isFeatured       Boolean         @default(false)
  isPremium        Boolean         @default(false)
  expiresAt        DateTime?
  views            Int             @default(0)
  whatsappClicks   Int             @default(0)
  qualifiedLeads   Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  reviews   Review[]
  proposals Proposal[]

  @@index([category])
  @@index([businessType])
  @@index([state])
  @@index([city])
  @@index([manufacturer])
  @@index([yearModel])
  @@index([engineHours])
  @@index([power])
  @@index([ownerId])
  @@index([price])
  @@map("machines")
}

model Proposal {
  id               String         @id @default(uuid())
  machineId        String
  senderId         String
  receiverId       String
  proposedPrice    Decimal        @db.Decimal(12, 2)
  message          String         @db.Text
  status           ProposalStatus @default(PENDING)
  counterPrice     Decimal?       @db.Decimal(12, 2)
  counterMessage   String?        @db.Text
  viewedByReceiver Boolean        @default(false)
  viewedBySender   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  machine  Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sender   User    @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ProposalReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("proposals")
}

model SiteSetting {
  id                  String   @id @default(uuid())
  siteName            String   @default("BaitaBriq")
  homeTitle           String?
  homeDescription     String?  @db.Text
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?  @db.Text
  whatsappSupport     String?
  phoneSupport        String?
  emailSupport        String?
  socialLinks         Json     @default("{\"instagram\":\"\",\"facebook\":\"\",\"youtube\":\"\",\"linkedin\":\"\"}") 
  termsOfUse          String?  @db.Text
  privacyPolicy       String?  @db.Text
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("categories")
}

model Banner {
  id         String   @id @default(uuid())
  imageUrl   String
  link       String?
  active     Boolean  @default(true)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("banners")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  planId            String
  mercadoPagoId     String?
  externalReference String
  amount            Decimal  @db.Decimal(10, 2)
  status            String   @default("pending")
  webhookType       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mercadoPagoId])
  @@index([status])
  @@map("payments")
}

model VerificationRequest {
  id             String   @id @default(uuid())
  userId         String
  documentType   String
  documentNumber String
  companyName    String
  phone          String
  email          String
  reason         String?  @db.Text
  status         String   @default("PENDING")
  rejectReason   String?  @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

model Plan {
  id               String  @id @db.VarChar(20)
  name             String  @db.VarChar(50)
  price            Decimal @default(0) @db.Decimal(10, 2)
  maxAds           Int     @default(2)
  maxPhotos        Int     @default(3)
  maxVideos        Int     @default(0)
  adDuration       Int     @default(30)
  maxPremiumAds    Int     @default(0)
  maxFeaturedAds   Int     @default(0)
  hasAnalytics     Boolean @default(false)
  analyticsLevel   String  @default("none") @db.VarChar(20)
  hasPriority      Boolean @default(false)
  hasStorePage     Boolean @default(false)
  hasVerifiedBadge Boolean @default(false)
  supportLevel     String  @default("email_48h") @db.VarChar(20)
  features         Json    @default("[]")
  isActive         Boolean @default(true)

  @@map("plans")
}
