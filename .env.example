# ======================
# DATABASE (REQUIRED)
# ======================
# Connection pool parameters:
# - connection_limit: Max connections in pool (10 for dev, 20 for prod)
# - pool_timeout: Max seconds waiting for connection (10s)
# - connect_timeout: Max seconds to establish connection (5s)
DATABASE_URL="postgresql://user:password@localhost:5432/equipment_rental?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5"

# ======================
# JWT (REQUIRED)
# ======================
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"

# ======================
# APP
# ======================
PORT=3000
NODE_ENV="development"

# ======================
# FRONTEND (REQUIRED)
# ======================
# Local: http://localhost:3001
# Production: https://mercadomaquina.online
FRONTEND_URL="http://localhost:3001"

# ======================
# EMAIL (REQUIRED)
# ======================
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# ======================
# PAYMENT (REQUIRED)
# ======================
# Get your token at: https://www.mercadopago.com.br/developers/panel/credentials
# Use TEST token for development, PROD token for production
MERCADOPAGO_ACCESS_TOKEN="TEST-your-mercadopago-token"

# ======================
# OBSERVABILITY (OPTIONAL)
# ======================
# Sentry - Error tracking: https://sentry.io
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ENVIRONMENT="development"

# BetterStack - Logs: https://betterstack.com
BETTERSTACK_TOKEN="your_token_here"
